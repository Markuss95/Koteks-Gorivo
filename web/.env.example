# Base URL of the backend API.
# Leave empty for local dev (Vite proxies /api to the backend on :4000).
# In production (Netlify), set to the Render backend URL, e.g.:
# VITE_API_BASE_URL=https://koteks-gorivo-api.onrender.com
VITE_API_BASE_URL=

# CARTO basemap API key (required since Aug 2026, otherwise map tiles show an
# "API KEY REQUIRED" watermark). Free key, emailed instantly:
# https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=
