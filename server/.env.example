# ---- Server ----
PORT=4000
# SQLite database file (relative to server working dir, or absolute e.g. /data/koteks-gorivo.db)
DB_PATH=./data/koteks-gorivo.db
# Allowed browser origin (CORS). Empty = allow all (local/dev).
# In production set to the Netlify site URL, e.g. https://koteks-gorivo.netlify.app
CORS_ORIGIN=

# ---- MARIS (ERP) ----
MARIS_BASE_URL=https://portal.osijek-koteks.hr
MARIS_CLIENT_ID=your-client-id
MARIS_CLIENT_SECRET=your-client-secret

# ---- LiDAT (Liebherr telematics) ----
LIDAT_BASE_URL=https://www.lidatexternal.liebherr.com/LidatExternal/Service.svc
# Note: username contains a backslash, e.g. Osi_Osi_HR\aempservice
LIDAT_USERNAME=Organisation\username
LIDAT_PASSWORD=your-password
# Optional label for logs/health (default: "primary")
LIDAT_LABEL=osijek
# Optional additional AEMP logins. Each login exposes its own (disjoint) fleet;
# the sync fetches every account and routes each machine to the one that serves
# it. Add _2, _3, ... — enumeration stops at the first missing username/password.
# Each may override the base URL (LIDAT_BASE_URL_2) and set a label (LIDAT_LABEL_2).
# LIDAT_USERNAME_2=Organisation2\username
# LIDAT_PASSWORD_2=your-password
# LIDAT_LABEL_2=velika

# Optional: PEM file with the Maris server's intermediate CA cert. The Maris host
# omits its intermediate from the TLS chain, so Node needs it supplied here.
# Defaults to ./certs/sectigo-intermediate.pem (bundled).
# MARIS_CA_FILE=./certs/sectigo-intermediate.pem

# ---- Sync ----
# Cron expression for the LiDAT history sync (default: every 6 hours)
LIDAT_SYNC_CRON=0 */6 * * *
# Run a sync once on server startup (true/false)
LIDAT_SYNC_ON_START=true

# ---- Defaults (can be overridden in app settings) ----
# Comma-separated Maris article codes counted as fuel
FUEL_ARTICLE_CODES=06010001

# Earliest date (YYYY-MM-DD) allowed in comparisons. LiDAT serves only 14 days,
# so there is no history before collection started — requests before this are rejected.
DATA_MIN_DATE=2026-05-27

# ---- Auth ----
# Secret for signing login tokens (JWT). Use a long random value; keep it private.
# Generate e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (default 7d).
JWT_TTL=7d
# First administrator, created automatically on first boot if no users exist yet.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me
